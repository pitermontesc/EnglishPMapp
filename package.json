{
  "name": "daily-english",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "icons": "node scripts/make-icons.mjs && capacitor-assets generate --ios --iconBackgroundColor '#2046c7' --iconBackgroundColorDark '#2046c7' --splashBackgroundColor '#eef1f4' --splashBackgroundColorDark '#10161d'",
    "sync": "vite build && cap sync ios",
    "mac": "vite build && cap sync ios && cap open ios",
    "deploy:web": "sh scripts/deploy-pages.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capgo/capacitor-speech-recognition": "^8.6.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "sharp": "^0.35.5",
    "vite": "^8.3.8"
  }
